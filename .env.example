# Copy to .env, or let `uv run python -m gds.cli setup` create it for you.

# Supabase transaction pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Generated by `gds setup`
TOKEN_ENC_KEY=
TICK_SECRET=
MCP_PATH_SECRET=

# Which account row this deployment syncs
GDS_ACCOUNT_LABEL=default

# Public URL of your deployment (custom domain or <project>.vercel.app). Used by the CLI;
# the pg_cron tick URL lives in Vault (`gds_tick_url`).
GDS_BASE_URL=https://<your-domain>

# Optional: failure alerts by email via Resend (https://resend.com, free tier).
# With the default sender (onboarding@resend.dev), ALERT_EMAIL must be your Resend account email.
RESEND_API_KEY=
ALERT_EMAIL=
# ALERT_FROM=Garmin Datastore <alerts@your-verified-domain>
