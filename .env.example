# Copy to .env and fill in DATABASE_URL (README, step 3). `gds setup` fills in the rest.
# .env is git-ignored. Never commit it.

# Supabase transaction pooler connection string (port 6543), as the `postgres` user.
# Used on your machine only (migrations, setup, CLI); the deployed app gets the worker login below.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Generated by `gds setup`
TOKEN_ENC_KEY=
TICK_SECRET=
MCP_PATH_SECRET=
# The app's own database login (role gds_worker); pushed to Vercel as DATABASE_URL.
WORKER_DATABASE_URL=

# Set by `gds owner-password` (a hash only): the password you type when Claude connects.
OWNER_PASSWORD_HASH=

# Which account row this deployment syncs
GDS_ACCOUNT_LABEL=default

# Public URL of your deployment, e.g. https://garmin-datastore-yourname.vercel.app (or a custom
# domain). Known after the first deploy; `gds setup` then stores the tick URL in Supabase Vault.
GDS_BASE_URL=https://<your-deployment>

# Optional: failure alerts by email via Resend (https://resend.com, free tier).
# With the default sender (onboarding@resend.dev), ALERT_EMAIL must be your Resend account email.
RESEND_API_KEY=
ALERT_EMAIL=
# ALERT_FROM=Garmin Datastore <alerts@your-verified-domain>

# Optional: W-9, update Strava activity titles/descriptions. Create an API app at
# strava.com/settings/api (callback domain: your deployment's domain), then run
# `gds strava-auth` (asks for these if missing) and `gds setup`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
